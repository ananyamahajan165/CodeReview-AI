# --- Server ---
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# --- MongoDB (local or Atlas) ---
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/codereview-ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/codereview-ai

# --- Auth --- generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# --- AI provider ---
# anthropic -> https://console.anthropic.com   |   openai -> OpenAI or any OpenAI-compatible API
AI_PROVIDER=anthropic
AI_API_KEY=
# Optional: leave blank to use the provider default model
AI_MODEL=
# Optional: only for openai-compatible providers (e.g. https://api.groq.com/openai/v1)
AI_BASE_URL=
AI_TIMEOUT_MS=60000
MAX_CODE_CHARS=20000
